# Whisper Gateway URL.
# Inside docker-compose on infra-net the container resolves the gateway at
# http://whisper-gateway:5000. From the host machine the gateway is published
# on port 5148 (see the gateway's compose file), so local dev should use that.
WHISPER_GATEWAY_URL=http://100.79.146.102:5148

# Ollama base URL — used by /api/report to call the chat/generate endpoint.
# Inside docker-compose on infra-net, the host is just `ollama:11434`.
# From the host machine, use the published host:port.
OLLAMA_URL=http://100.79.146.102:11434

# Model used for report generation. Pull it on the Ollama host first
# (`ollama pull gemma4:e4b`). Override per-deploy if you swap models.
OLLAMA_MODEL=gemma4:e4b
